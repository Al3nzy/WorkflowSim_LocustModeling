#!/bin/bash
# Code Ocean entry point: runs every experiment of the paper, draws every figure, recomputes every
# statistic quoted in the paper, and copies everything to Code Ocean's results tab (/results).
# 
# The code to run the experiments is in Java, the analysis and plotting code is in Python Using VS Code. 
#  java -cp "bin;lib/*" org.workflowsim.examples.planning.RunPaperExperiments; python paper_statistics.py; python make_paper_figures.py; python generate_figures.py --all; python summarize_results.py; 
#   Java  : RunPaperExperiments   (writes Output&Results/paper_*.csv and *_summary.txt)
#             paper_main.csv              main benchmark, six algorithms, one planning-level hypervolume evaluator
#             paper_variant_A/B.csv       component analysis (A = published LIWSA/LIWSA-ML, B = + external archive)
#             paper_density_ablation.csv  measured density vs fixed mixing probability
#             paper_naive.csv             OLS predictor vs naive duration/cost scoring
#             paper_lambda.csv, paper_theta.csv   parameter sensitivity sweeps
#             paper_pricing.csv           VM-pricing sensitivity
#             paper_equal_time.csv        LIWSA-ML vs NSGA-II at matched wall-clock time (timing based)
#   Python: paper_statistics.py   -> paper_statistics.txt: every hypervolume statistic of the paper (tables IV-VI,
#                                    Wilcoxon/Holm tests, component analysis, ablations, sweeps, matched wall-clock)
#           make_paper_figures.py -> the result figures used in the paper (PDF)
#           generate_figures.py   -> additional per-file figures and the all-algorithm summary tables
#
# Set QUICK=1 (environment variable) for a two-workflow smoke test of the whole chain (a few minutes).
# The matched wall-clock step measures run time, so the full run should have the machine to itself.
set -ex
cd "$(dirname "$0")"

OUT="Output&Results"          # the folder name contains an ampersand: always keep it quoted
RESULTS="../results"          # Code Ocean's persistent results folder (= /results when this file is /code/run)
mkdir -p "$OUT" "$RESULTS" bin

# 1. Compile every Java source file
find sources examples -name "*.java" > sources.txt
javac -nowarn -encoding UTF-8 -cp "lib/*" -d bin @sources.txt

# 2. Run all experiments of the paper (writes Output&Results/paper_*.csv and *_summary.txt)
if [ "${QUICK:-0}" = "1" ]; then
    java -cp "bin:lib/*" org.workflowsim.examples.planning.RunPaperExperiments "Montage_25,Sipht_30"
else
    java -cp "bin:lib/*" org.workflowsim.examples.planning.RunPaperExperiments
fi

# 3. FIRST COPY: put the CSV files and summaries into the results tab right away,
#    so they are kept even if a later (analysis or plotting) step fails
cp -r "$OUT"/paper_* "$RESULTS"/

# 4. Python: statistics quoted in the paper, then the paper figures, then additional figures and summary tables.
#    A failing analysis step must not lose the results already copied, so these lines do not abort the run.
python3 paper_statistics.py --dir "$OUT" || echo "WARNING: paper_statistics.py failed"
python3 make_paper_figures.py "$OUT/paper_main.csv" --outdir "$OUT/paper_figures" || echo "WARNING: make_paper_figures.py failed"
python3 generate_figures.py --all --outdir "$OUT/figures" || echo "WARNING: generate_figures.py --all failed"
python3 summarize_results.py "$OUT/paper_main.csv" || echo "WARNING: summarize_results.py failed"

# 5. SECOND COPY: statistics, figures (PDF and PNG) and the Python summary files
cp "$OUT"/paper_statistics.txt "$RESULTS"/ 2>/dev/null || true
[ -d "$OUT/paper_figures" ] && cp -r "$OUT/paper_figures" "$RESULTS"/
[ -d "$OUT/figures" ]       && cp -r "$OUT/figures" "$RESULTS"/
cp "$OUT"/paper_*_summary*.txt "$RESULTS"/ 2>/dev/null || true
echo "Done. Results copied to $RESULTS"
